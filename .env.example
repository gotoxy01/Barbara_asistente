# --- WhatsApp por código QR (npm start) ---
# Carpeta donde se guarda la sesión para no escanear el QR cada vez.
# Vacío = %LOCALAPPDATA%\barbara-los-cuchos\wwebjs_auth (fuera de OneDrive, recomendado)
WWEB_SESSION_PATH=
# false = muestra la ventana de Chrome (útil para depurar)
WWEB_HEADLESS=true

# --- Servidor (solo para npm run start:cloud) ---
PORT=3000

# --- WhatsApp Cloud API (solo para npm run start:cloud) ---
# (Meta for Developers > su App > WhatsApp > Configuración de la API)
# Token de acceso (use un token permanente de Usuario del Sistema en producción)
WHATSAPP_TOKEN=
# ID del número de teléfono (Phone number ID), NO el número en sí
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que usted inventa; debe coincidir con el "Verify token" del webhook en Meta
WHATSAPP_VERIFY_TOKEN=los-cuchos-verify
# Clave secreta de la app (Configuración > Básica). Opcional pero recomendado: valida la firma de Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=AQ.Ab8RN6IdIktbS6qTMsE06Q2TOM3-ItV7LDFBUAF0fjhjFaLagw
GEMINI_MODEL=gemini-3.8-flash
# Reintentos ante fallas pasajeras de Google (429 por ráfaga, 5xx)
GEMINI_MAX_RETRIES=2
# Modelo de respaldo inmediato si el principal está saturado (503) o tarda más de GEMINI_TIMEOUT_MS
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000
# true = pausar el chat y escalar cuando la IA falla; false = avisar al cliente que reintente
PAUSE_ON_ERROR=false

# --- Datos de Pago Móvil que Bárbara envía al cerrar el pedido ---
PAGO_MOVIL_TELEFONO=0414-3697834
PAGO_MOVIL_CEDULA=29953424
PAGO_MOVIL_BANCO=Banesco

# Horas sin conversar para que Bárbara se vuelva a presentar
NEW_CONVERSATION_HOURS=6

# Soporte de ferretería (ej. 0414-3697834 o 584143697834). Bárbara le pasa este contacto
# al cliente que pide artículos de ferretería. Vacío = Bárbara atiende la ferretería como cualquier producto.
FERRETERIA_PHONE=0414-3697834

# Minutos que Bárbara se queda callada en un chat cuando un asesor le escribe a mano al cliente
MANUAL_PAUSE_MINUTES=5

# --- Escalado a humano ---
# Número del asesor en formato internacional sin "+" ni espacios (ej. 584121234567).
# Con QR, si se deja vacío, los avisos llegan a "Mensajes para mí" del propio WhatsApp del negocio.
ADVISOR_PHONE=
# Horas que el bot permanece pausado en un chat escalado antes de reactivarse solo
BOT_PAUSE_HOURS=12

# --- Conversación ---
# Cantidad de mensajes previos que se envían a Gemini como historial
HISTORY_LIMIT=20
TIMEZONE=America/Caracas
# Base de datos propia del bot (historial de chats). NO use aquí la base del sistema de caja.
DB_PATH=barbara.db

# --- Delivery ---
# Tarifa si el pedido incluye botellón de agua
DELIVERY_BOTELLON_USD=1.00
# Tarifa si el pedido incluye cualquier otro producto (se suman ambas si hay de los dos)
DELIVERY_GENERAL_USD=1.50

# --- Tasa BCV ---
# Déjelo vacío para consultar la tasa oficial en línea; ponga un número (ej. 857.0058) para fijarla a mano
BCV_RATE=
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
# Cada cuántos minutos se vuelve a consultar la tasa
BCV_REFRESH_MINUTES=60

# --- Catálogo de productos ---
# auto = usa la base del sistema de caja si existe, si no el JSON | db | json
CATALOG_SOURCE=auto
# Base de datos del sistema de caja (se abre en solo lectura)
CATALOG_DB_PATH=database.db
# Catálogo alterno en JSON
CATALOG_JSON_PATH=data/products.json
# Cada cuántos minutos se vuelven a leer los precios
CATALOG_REFRESH_MINUTES=5
# Máximo de productos que se le pasan a Bárbara por consulta
CATALOG_MAX_RESULTS=12