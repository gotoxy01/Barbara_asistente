# Copie este archivo a .env y complete los valores. No suba el .env al repositorio.

# --- WhatsApp Cloud API (canal principal: npm start) ---
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Plantilla aprobada en Meta. Se usa fuera de la ventana de 24 h (y si Meta responde 131047).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_CONCURRENCY=2
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BUDGET_MS=45000
AUDITOR_ENABLED=true
AUDITOR_MODEL=

# --- Postgres local de la tienda (obligatorio). No use Supabase para estos datos. ---
DATABASE_URL=postgresql://barbara:CAMBIE_ESTA_CLAVE@127.0.0.1:5432/barbara
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
HYBRID_KEYWORD_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45

# --- Redis opcional. Vacío = cola en memoria. En Windows: Memurai o Redis en WSL/Docker. ---
REDIS_URL=

# --- Negocio (obligatorios; no deje datos reales en el código) ---
PAGO_MOVIL_TELEFONO=
PAGO_MOVIL_CEDULA=
PAGO_MOVIL_BANCO=
CRM_TOKEN=
ADVISOR_PHONE=

# --- Confianza, cola y ventana de 24 h ---
CONFIDENCE_THRESHOLD=85
DEBOUNCE_WINDOW_MS=3500
SERVICE_WINDOW_HOURS=24
# 0 = un chat en SPECIALIST no vuelve solo. Un número > 0 lo reanuda pasado ese plazo.
SPECIALIST_AUTO_RESUME_HOURS=0

# --- Panel local ---
PORT=3000
CRM_HOST=127.0.0.1
CRM_PORT=3847

# --- Catálogo y tasa ---
# auto usa database.db de la caja si existe; si no, data/products.json (catálogo de prueba).
CATALOG_SOURCE=auto
CATALOG_DB_PATH=database.db
CATALOG_JSON_PATH=data/products.json
CATALOG_REFRESH_MINUTES=5
CATALOG_MAX_RESULTS=12
BCV_RATE=0
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
BCV_REFRESH_MINUTES=60

# --- Pedidos ---
DB_PATH=barbara.db
DELIVERY_ITEM_NAME=Delivery costo
DELIVERY_FALLBACK_USD=1.5
ORDER_MEMORY_HOURS=24
HISTORY_LIMIT=20
NEW_CONVERSATION_HOURS=6
CATCHUP_HOURS=1
MANUAL_PAUSE_MINUTES=5
PAUSE_ON_ERROR=false
TIMEZONE=America/Caracas
OPERATOR_BUTTONS_ENABLED=true
OPERATOR_TICKETS_PERSIST=true
OPERATOR_WA_PING=false
OPERATOR_HIGH_ORDER_USD=50
LOG_VERBOSE=false

# --- Respaldo con código QR (npm run start:qr). No hace falta para Cloud. ---
WWEB_SESSION_PATH=
WWEB_HEADLESS=true
WWEB_DEBUG=false
WWEB_GROUPS=Bodega los cuchos
