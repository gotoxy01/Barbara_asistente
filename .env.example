# =============================================================================
# Bárbara — Abasto Los Cuchos
# Este es el ÚNICO archivo que hay que editar.
# Copie este ejemplo a .env (npm run setup lo hace solo) y complete los huecos.
# Para cambiar el número de WhatsApp, el del asesor o cualquier otro dato,
# modifique aquí y vuelva a iniciar. No hace falta tocar el código.
# No suba el archivo .env a internet.
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp / Meta
# Token permanente de un usuario de sistema (el token de prueba se vence).
# El Phone number ID es el número de la API, no el teléfono con 0414.
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v26.0

# -----------------------------------------------------------------------------
# Gemini
# La clave se crea en https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_STABLE_MODELS=gemini-3.5-flash,gemini-flash-latest
GEMINI_CONCURRENCY=2
GEMINI_TIMEOUT_MS=12000
# Tope de tokens de la respuesta (el saludo y la venta no necesitan más).
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BUDGET_MS=15000
AUDITOR_ENABLED=true
AUDITOR_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# Base de datos
# POSTGRES_ADMIN_URL es el usuario que creó el instalador de PostgreSQL
# (casi siempre "postgres" y la clave que usted eligió al instalarlo).
# DATABASE_URL es la base de la tienda. Cambie CAMBIE_ESTA_CLAVE por una clave propia.
# -----------------------------------------------------------------------------
POSTGRES_ADMIN_URL=postgresql://postgres:CLAVE_DEL_INSTALADOR@127.0.0.1:5432/postgres
DATABASE_URL=postgresql://barbara:CAMBIE_ESTA_CLAVE@127.0.0.1:5432/barbara

# -----------------------------------------------------------------------------
# Negocio / pago móvil
# ADVISOR_PHONE: celular del asesor, solo números, con 58. Ejemplo: 584141234567
# Si lo deja vacío, en el modo QR los avisos van a "Mensajes para mí".
# -----------------------------------------------------------------------------
PAGO_MOVIL_TELEFONO=
PAGO_MOVIL_CEDULA=
PAGO_MOVIL_BANCO=
ADVISOR_PHONE=
CRM_TOKEN=elija-una-frase-secreta-del-panel

# -----------------------------------------------------------------------------
# Panel
# El buzón se abre en http://127.0.0.1:3847
# -----------------------------------------------------------------------------
PORT=3000
CRM_HOST=127.0.0.1
CRM_PORT=3847

# -----------------------------------------------------------------------------
# Opcional Redis
# Vacío = la cola queda en memoria (sirve para una sola PC).
# En Windows puede usar Memurai o Redis en WSL/Docker.
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Otros (puede dejar estos valores)
# -----------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=85
DEBOUNCE_WINDOW_MS=3500
# Tope por número. Al pasarse, no se llama al modelo y se bloquea BLOQUEO_MINUTOS.
MAX_MENSAJES_POR_MINUTO=10
MAX_MENSAJES_POR_DIA=150
BLOQUEO_MINUTOS=30
SERVICE_WINDOW_HOURS=24
SPECIALIST_AUTO_RESUME_HOURS=0
BOT_PAUSE_HOURS=12
CATALOG_SOURCE=auto
# Caja real, o la de prueba tras npm run caja:demo:
# CATALOG_SOURCE=db
# CATALOG_DB_PATH=data/caja-demo/database.db
CATALOG_DB_PATH=database.db
CATALOG_JSON_PATH=data/products.json
CATALOG_REFRESH_MINUTES=5
CATALOG_MAX_RESULTS=12
BCV_RATE=0
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
BCV_REFRESH_MINUTES=60
DB_PATH=barbara.db
DELIVERY_ITEM_NAME=Delivery costo
DELIVERY_FALLBACK_USD=1.5
ORDER_MEMORY_HOURS=24
HISTORY_LIMIT=20
NEW_CONVERSATION_HOURS=6
CATCHUP_HOURS=1
MANUAL_PAUSE_MINUTES=5
PAUSE_ON_ERROR=false
TIMEZONE=America/Caracas
OPERATOR_BUTTONS_ENABLED=true
OPERATOR_TICKETS_PERSIST=true
OPERATOR_WA_PING=false
OPERATOR_HIGH_ORDER_USD=50
LOG_VERBOSE=false
HYBRID_KEYWORD_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45
WWEB_SESSION_PATH=
WWEB_HEADLESS=true
WWEB_DEBUG=false
WWEB_GROUPS=Bodega los cuchos
PUPPETEER_EXECUTABLE_PATH=
